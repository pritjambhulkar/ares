-- Create Database
CREATE DATABASE EmployeeDB;
GO

-- Select Database
USE EmployeeDB;
GO

-- Create Employee Table
CREATE TABLE Employee
(
    EmployeeID INT PRIMARY KEY,
    EmployeeName VARCHAR(100) NOT NULL,
    Email VARCHAR(100),
    Department VARCHAR(50),
    Salary DECIMAL(10,2),
    JoiningDate DATE
);
GO

